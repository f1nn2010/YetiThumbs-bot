# Required Discord credentials
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here
# Guild registration makes the three commands appear immediately.
GUILD_ID=your_discord_guild_id_here
OWNER_IDS=
DISCORD_STAFF_ROLE_IDS=1532481208490131651,1532481208490131652
DISCORD_TICKET_CATEGORY_ID=

# Required YetiThumbs Supabase service credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
PUBLIC_APP_URL=https://yetithumbs.com

# Optional one-time credits game-pass links.
ROBUX_LINK_10C=
ROBUX_LINK_40C=
ROBUX_LINK_90C=

# Optional premium Robux prices per month. Developer keeps the original 1,200 R$ default.
# Starter and Enterprise display "staff confirms price" until configured.
ROBUX_PRICE_STARTER_MONTHLY=
ROBUX_PRICE_DEVELOPER_MONTHLY=1200
ROBUX_PRICE_ENTERPRISE_MONTHLY=

# Optional premium game-pass links for each level and duration.
ROBUX_LINK_STARTER_1M=
ROBUX_LINK_STARTER_3M=
ROBUX_LINK_STARTER_6M=
ROBUX_LINK_DEVELOPER_1M=
ROBUX_LINK_DEVELOPER_3M=
ROBUX_LINK_DEVELOPER_6M=
ROBUX_LINK_ENTERPRISE_1M=
ROBUX_LINK_ENTERPRISE_3M=
ROBUX_LINK_ENTERPRISE_6M=

# Railway / Docker health endpoints: /health and /ready
NODE_ENV=production
PORT=3000
WEB_HOST=0.0.0.0
