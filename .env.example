# Required Discord credentials
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here
# Guild registration makes the three commands appear immediately.
GUILD_ID=your_discord_guild_id_here
OWNER_IDS=
DISCORD_STAFF_ROLE_IDS=1532481208490131651,1532481208490131652
DISCORD_TICKET_CATEGORY_ID=

# Required YetiThumbs Supabase service credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional Roblox game-pass links. When unset, the ticket tells staff to provide the link.
ROBUX_LINK_10C=
ROBUX_LINK_40C=
ROBUX_LINK_90C=
ROBUX_LINK_1M=
ROBUX_LINK_3M=
ROBUX_LINK_6M=

# Railway / Docker health endpoints: /health and /ready
NODE_ENV=production
PORT=3000
WEB_HOST=0.0.0.0
